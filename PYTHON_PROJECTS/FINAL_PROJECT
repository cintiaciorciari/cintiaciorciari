import json                       #uso dos modulos, json para validar datos y datetime para validar fechas
from datetime import datetime
 
DATE_FORMAT = "%Y-%m-%d %H:%M"

try:                             #si el archivo aun no existe,comienza con un diccionario vacio, Load appointments from file
    with open("appointments.json", "r") as file:
        appointments = json.load(file)
except FileNotFoundError:
    appointments = {}

#menu: 

print("1 - Add appointment")
print("2 - Check a date")
choice = input("Choose: ")

# ── Option 1: Add appointment( verifica si la fecha ya es una clave en el diccionario. si no, guardala)

if choice == "1":
    name  = input("Patient name : ")
    phone = input("Phone number : ")
    email = input("Email        : ")
    date  = input("Date & time  (YYYY-MM-DD HH:MM) : ")

    # Validate the date format
    try:
        datetime.strptime(date, DATE_FORMAT) #esto valida que el ususario haya escrito una fecha real,si no el programa se detiene.
    except ValueError:
        print("Wrong date format!")
        exit()
 
    # Check if slot is already taken /comprobar si el espacio ya esta ocupado
    if date in appointments:
        print(f"Sorry, {date} is already booked by {appointments[date]['name']}.")
    else:
        appointments[date] = {
            "name":  name,
            "phone": phone,
            "email": email
        }
        with open("appointments.json", "w") as file:
            json.dump(appointments, file, indent=4)  #guarda todo de nuevo en el archivo,igual que tu codigo de contactos.
        print(f"Appointment saved for {name} on {date}.")

# ── Option 2: Check a date -verifica que las fechas este en la cita

elif choice == "2":
    date = input("Date & time to check (YYYY-MM-DD HH:MM) : ")

    try:
        datetime.strptime(date, DATE_FORMAT)
    except ValueError:
        print("Wrong date format!")
        exit()

    if date in appointments:
        appt = appointments[date]
        print(f"TAKEN - booked by {appt['name']}")
        print(f"Phone : {appt['phone']}")
        print(f"Email : {appt['email']}")
    else:
        print(f"{date} is available.")

else:
    print("Invalid option.")
